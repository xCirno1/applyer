{
  "name": "applyer",
  "version": "0.1.0",
  "description": "Local Electron app for autonomous job hunting via CLI agents (Claude Code, Codex, etc.)",
  "main": "./out/main/index.js",
  "desktopName": "com.applyer.app.desktop",
  "author": "xCirno1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xCirno1/applyer.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty && cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:site": "tsx scripts/test-site.ts",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.0",
    "mammoth": "^1.12.1",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "sanitize-html": "^2.17.7",
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@swc/core": "^1.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.applyer.app",
    "productName": "Applyer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/playwright-core/.local-browsers/**",
      "!**/node_modules/@napi-rs/canvas*/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "icon": "resources/icon.png",
    "extraResources": [
      {
        "from": "resources/mcp-bridge.mjs",
        "to": "mcp-bridge.mjs"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
